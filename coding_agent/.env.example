# ============================================================
# Coding Agent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================================

# API Key（必填）
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:  https://platform.openai.com/api-keys
API_KEY=sk-your-api-key-here

# 模型名称（默认使用 DeepSeek）
MODEL_NAME=deepseek-chat

# API 地址（DeepSeek 兼容 OpenAI 格式）
BASE_URL=https://api.deepseek.com

# 最大工具调用轮数（防止无限循环）
MAX_TOOL_ROUNDS=5

# 上下文窗口保留的最近对话轮数（滑动窗口参数）
MAX_RECENT_ROUNDS=10

# 上下文 token 上限（用于触发智能压缩的阈值）
# 轻度压缩不触发（<70%）、中度压缩（70%-90%）、重度压缩（>90%）
CONTEXT_LIMIT_TOKENS=80000
